---
title: All Writings
layout: base.njk
---

<section class="page-header">
  <h1>All Writings</h1>
  <p class="page-description">Every article in the archive, sorted by date.</p>
</section>

<div class="search-box">
  <input type="search" id="search-input" placeholder="Search writings..." aria-label="Search writings" autocomplete="off">
  <span class="search-count" id="search-count" aria-live="polite"></span>
</div>

<section class="tag-cloud tag-cloud-compact">
  {% for tag in collections.tagList | limit(15) %}
  <a href="{{ '/tags/' | url }}{{ tag.slug }}/" class="tag-cloud-item" data-count="{{ tag.writings.length }}">
    <span class="tag-cloud-name">{{ tag.name }}</span>
    <span class="tag-cloud-count">{{ tag.writings.length }}</span>
  </a>
  {% endfor %}
  <a href="{{ '/tags/' | url }}" class="tag-cloud-more">All tags →</a>
</section>

<section class="writing-list-section">
  <ul class="writing-list writing-list-cards" id="writing-list">
  {% for writing in collections.writings | sortByDate %}
    <li class="writing-list-item" data-title="{{ writing.data.title | lower }}" data-description="{{ (writing.data.description or '') | lower }}" data-collection="{{ writing.data.collection }}" data-tags="{{ (writing.data.tags or []) | join(' ') | lower }}">
      <a href="{{ writing.url | url }}" class="writing-list-title">{{ writing.data.title }}</a>
      <span class="writing-list-meta">{{ writing.data.date | formatDate }} · {{ writing.data.collection }}</span>
      <span class="writing-list-reading-time">{{ writing.templateContent | readingTime }}</span>
    </li>
  {% endfor %}
  </ul>
  <p class="search-no-results" id="search-no-results" style="display:none;">No writings found. Try a different search term.</p>
</section>

<script src="{{ '/search.js' | url }}?v=1" defer></script>
