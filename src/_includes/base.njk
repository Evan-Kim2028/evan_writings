<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}Evan's Writings</title>
  <meta name="description" content="{{ description or 'Agents, evals, data. Writing by Evan Kim.' }}">
  <meta name="author" content="Evan Kim">
  <meta name="theme-color" content="#fbfbf9">
  <script>(function(){var t;try{t=localStorage.getItem('theme')}catch(e){}if(!t){t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.dataset.theme=t})();</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/vendor/katex.min.css' | url }}">
  {%- if keywords -%}
  <meta name="keywords" content="{{ keywords }}">
  {%- endif -%}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/styles.css' | url }}?v=16">
  <link rel="alternate" type="application/rss+xml" title="Evan's Writings" href="{{ '/feed.xml' | absoluteUrl }}">

  {# Compute article-level SEO data when this is a writing page.
     We detect writing pages by the presence of a `collection` frontmatter field
     (set by every writing .md). Layouts/index pages don't have it. #}
  {%- set _is_article = collection and page.url and page.url.indexOf('/writings/') === 0 -%}
  {%- set _first_img = content | firstImage -%}
  {%- set _og_image = _first_img | absoluteImageUrl -%}
  {%- if not _og_image -%}
  {%- set _og_image = '/evan_writings/assets/og-default.png' | absoluteImageUrl -%}
  {%- endif -%}
  {%- set _iso_date = date | isoDate -%}
  {%- set _seo_tags = tags | seoTags(collection) -%}

  {# Open Graph #}
  <meta property="og:site_name" content="Evan's Writings">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}Evan's Writings{% endif %}">
  <meta property="og:description" content="{{ description or 'Agents, evals, data. Writing by Evan Kim.' }}">
  <meta property="og:type" content="{% if _is_article %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:image" content="{{ _og_image }}">
  {%- if _is_article -%}
  {%- if _iso_date -%}
  <meta property="article:published_time" content="{{ _iso_date }}">
  {%- endif -%}
  <meta property="article:author" content="Evan Kim">
  {%- if collection -%}
  <meta property="article:section" content="{{ collection }}">
  {%- endif -%}
  {%- for tag in _seo_tags -%}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor -%}
  {%- endif -%}

  {# Twitter Card #}
  <meta name="twitter:card" content="{% if _is_article %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}Evan's Writings{% endif %}">
  <meta name="twitter:description" content="{{ description or 'Agents, evals, data. Writing by Evan Kim.' }}">
  <meta name="twitter:image" content="{{ _og_image }}">

  {# JSON-LD: WebSite + Person (site-wide) + Article (writing pages only) #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ '/' | absoluteUrl }}#website",
        "url": "{{ '/' | absoluteUrl }}",
        "name": "Evan's Writings",
        "description": "Agents, evals, data. Writing by Evan Kim.",
        "publisher": { "@id": "{{ '/' | absoluteUrl }}#person" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ '/writings/' | absoluteUrl }}?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Person",
        "@id": "{{ '/' | absoluteUrl }}#person",
        "name": "Evan Kim",
        "url": "{{ '/' | absoluteUrl }}",
        "sameAs": [
          "https://github.com/Evan-Kim2028",
          "https://x.com/evandekim",
          "https://www.linkedin.com/in/evan-kim-30943591"
        ]
      }
      {%- if _is_article -%},
      {
        "@type": "Article",
        "@id": "{{ page.url | absoluteUrl }}#article",
        "headline": {{ title | jsonify | safe }},
        "description": {{ description | jsonify | safe }},
        "datePublished": "{{ _iso_date }}",
        "dateModified": "{{ _iso_date }}",
        "url": "{{ page.url | absoluteUrl }}",
        "image": "{{ _og_image }}",
        "author": { "@id": "{{ '/' | absoluteUrl }}#person" },
        "publisher": { "@id": "{{ '/' | absoluteUrl }}#person" },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ page.url | absoluteUrl }}"
        },
        "isPartOf": { "@id": "{{ '/' | absoluteUrl }}#website" }
        {%- if _seo_tags and _seo_tags.length -%},
        "keywords": {{ _seo_tags | join(', ') | jsonify | safe }}
        {%- endif -%}
      }
      {%- endif -%}
    ]
  }
  </script>
</head>
<body data-base="{{ '/' | url }}">
  <a href="#main" class="skip-link">Skip to content</a>
  <div id="progress" aria-hidden="true"></div>
  <header class="site">
    <nav aria-label="Main">
      <a href="{{ '/' | url }}" class="brand" aria-label="Evan Kim home">Evan Kim</a>
      <div class="nav-links">
        <a href="{{ '/writings/' | url }}"{% if page.url == '/writings/' %} aria-current="page"{% endif %}>Writing</a>
        <a href="{{ '/collections/' | url }}"{% if page.url == '/collections/' %} aria-current="page"{% endif %}>Collections</a>
        <a href="{{ '/tags/' | url }}"{% if page.url == '/tags/' %} aria-current="page"{% endif %}>Tags</a>
        <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
          <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </nav>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site">
    <div class="inner">
      <span>Evan Kim · <a href="https://github.com/Evan-Kim2028/evan_writings">Source</a> · <a href="{{ '/llms-full.txt' | url }}">llms-full.txt</a></span>
      <span class="links">
        <a href="https://x.com/evandekim">X</a>
        <a href="https://github.com/Evan-Kim2028">GitHub</a>
        <a href="https://www.linkedin.com/in/evan-kim-30943591">LinkedIn</a>
        <a href="{{ '/feed.xml' | url }}">RSS</a>
      </span>
    </div>
  </footer>
  <script src="{{ '/site.js' | url }}?v=1" defer></script>
</body>
</html>
