---
layout: base.njk
---

{% set _toc = content | toc %}
<div class="article-layout">
  <aside class="rail">
    {% if _toc %}
    {{ _toc | safe }}
    {% endif %}
    <a href="{{ '/writings/' | url }}" class="rail-back">← All writing</a>
  </aside>

  <article class="article">
    {%- if hero -%}
    {%- set _hl = "url('" + (hero | url) + "')" -%}
    {%- set _hd = "url('" + ((hero_dark or hero) | url) + "')" -%}
    {%- else -%}
    {%- set _hl = slug | heroPattern('light') -%}
    {%- set _hd = slug | heroPattern('dark') -%}
    {%- endif -%}
    <header class="article-head has-hero{% if not hero %} has-pattern{% endif %}" style="--hero-light:{{ _hl | safe }};--hero-dark:{{ _hd | safe }}">
      <div class="kicker">
        <a href="{{ '/collections/' | url }}{{ collection }}/">{{ collection }}</a>
        &nbsp;·&nbsp; {{ date | formatDate }}
      </div>
      {% if series %}<p class="series-line">{{ series }} · Part {{ series_index }}</p>{% endif %}
      <h1 class="title">{{ title }}</h1>
      {% if description %}
      <p class="dek">{{ description }}</p>
      {% endif %}
      <div class="meta">
        <span>Evan Kim</span>
        {% if tags %}
          {% for tag in tags %}
            {% if tag | isTopicalTag %}
            <a href="{{ '/tags/' | url }}{{ tag | tagSlug }}/" class="tag tag-link">{{ tag }}</a>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </header>

    <div class="writing-body">
      {{ content | safe }}
    </div>
{%- if series -%}
{%- set _sameSeries = collections.writings | selectattr('data.series') | rejectattr('data.series','undefined') -%}
{%- set _prev = null -%}{%- set _next = null -%}
{%- for w in collections.writings -%}
  {%- if w.data.series == series and w.url != page.url -%}
    {%- if (w.data.series_index or 0) < (series_index or 0) and (not _prev or (w.data.series_index or 0) > (_prev.data.series_index or 0)) -%}{%- set _prev = w -%}{%- endif -%}
    {%- if (w.data.series_index or 0) > (series_index or 0) and (not _next or (w.data.series_index or 0) < (_next.data.series_index or 0)) -%}{%- set _next = w -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if _prev or _next -%}
<nav class="series-nav" aria-label="Series navigation">
  <div class="series-nav-head">{{ series }} series · Part {{ series_index }}</div>
  <div class="series-nav-links">
    {% if _prev %}<a class="series-prev" href="{{ _prev.url | url }}"><span class="k">← Previous · Part {{ _prev.data.series_index }}</span><span class="t">{{ _prev.data.title }}</span></a>{% else %}<span class="series-empty">This is the first part.</span>{% endif %}
    {% if _next %}<a class="series-next" href="{{ _next.url | url }}"><span class="k">Next · Part {{ _next.data.series_index }} →</span><span class="t">{{ _next.data.title }}</span></a>{% else %}<span class="series-empty">Next part not published yet.</span>{% endif %}
  </div>
</nav>
{%- endif -%}
{%- endif -%}


    <footer class="article-end">
      {% if source_url %}
      {% if source_note %}
      <p class="archive-note">{{ source_note }} <a href="{{ source_url }}" target="_blank" rel="noopener">{{ source_link_text or 'View source ↗' }}</a></p>
      {% else %}
      <p class="archive-note">Originally published on {{ source_platform or 'the web' }}, {{ date | formatDate }}. <a href="{{ source_url }}" target="_blank" rel="noopener">View original ↗</a></p>
      {% endif %}
      {% endif %}
      {% set _related = collections.writings | related(page, collection, 2) %}
      {% if _related.length %}
      <div class="related">
        {% for r in _related %}
        <a href="{{ r.url | url }}">
          <div class="k">More in {{ r.data.collection }} · {{ r.data.date | formatDate }}</div>
          <div class="t">{{ r.data.title }}</div>
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </footer>
  </article>
</div>
