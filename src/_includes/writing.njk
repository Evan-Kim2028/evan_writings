---
layout: base.njk
---

<section class="page-header">
  <a href="{{ '/writings/' | url }}" class="back-link">← All Writings</a>
  <h1>{{ title }}</h1>
  <div class="page-meta">
    <span class="date">{{ date | formatDate }}</span>
    <span class="collection-badge">{{ collection }}</span>
    {% set _rt = content | readingTime %}
    {% if _rt %}
    <span class="dot-sep">·</span>
    <span class="reading-time">{{ _rt }}</span>
    {% endif %}
  </div>
  {% if tags %}
  <div class="tags">
    {% for tag in tags %}
      <span class="tag">{{ tag }}</span>
    {% endfor %}
  </div>
  {% endif %}
  {% if source_url %}
  <p class="original-link">
    <a href="{{ source_url }}" target="_blank" rel="noopener">View original ↗</a>
  </p>
  {% endif %}
</section>

{% set _toc = content | toc %}
{% if _toc %}
<div class="writing-toc-wrapper">
  {{ _toc | safe }}
</div>
{% endif %}

<article class="writing-card">
  <div class="writing-body">
    {{ content | safe }}
  </div>
</article>
