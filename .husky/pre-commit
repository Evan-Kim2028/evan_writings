#!/usr/bin/env sh
# Pre-commit hook: verify the site still builds and renders correctly.
# Only runs the full build+verify if source files are staged.

# Ensure node/npm is available (Husky runs with a minimal PATH)
# Find the first node binary in nvm versions
NODE_BIN=""
for dir in "$HOME"/.nvm/versions/node/*/bin; do
  if [ -x "$dir/node" ]; then
    NODE_BIN="$dir"
    break
  fi
done
if [ -n "$NODE_BIN" ]; then
  export PATH="$NODE_BIN:$PATH"
fi

# Vale is a user-level binary install (see docs/linting.md)
export PATH="$HOME/.local/bin:$PATH"

cd "$(git rev-parse --show-toplevel)"

# Lint staged writing files (frontmatter + markdownlint + cspell + vale)
if [ -n "$(git diff --cached --name-only -- 'src/writings/*.md' | head -1)" ]; then
  echo "Pre-commit: writings staged, running linters..."
  npx lint-staged 2>&1
  if [ $? -ne 0 ]; then
    echo "Pre-commit: FAILED — lint errors in staged writings."
    echo "  See docs/linting.md for rules and how to suppress them."
    exit 1
  fi
fi

# Check if any source files are staged
STAGED=$(git diff --cached --name-only -- 'src/' '.eleventy.js' 'scripts/verify-site.mjs' | head -1)

if [ -n "$STAGED" ]; then
  echo "Pre-commit: source files staged, running build + verify..."
  npm run test 2>&1
  if [ $? -ne 0 ]; then
    echo "Pre-commit: FAILED — build or verify failed. Fix errors before committing."
    echo "  Run 'npm run test' to see the full output."
    exit 1
  fi
  echo "Pre-commit: OK — build and verify passed."
else
  echo "Pre-commit: no source files staged, skipping build verification."
fi
