{
  "name": "evan_writings",
  "version": "1.0.0",
  "description": "Personal writings and blog archive, hosted on GitHub Pages.",
  "scripts": {
    "dev": "eleventy --serve --watch",
    "build": "eleventy",
    "verify": "node scripts/verify-site.mjs",
    "test": "npm run build && npm run verify",
    "new": "node scripts/new-post.mjs",
    "suggest-tags": "node scripts/suggest-tags.mjs",
    "check-links": "node scripts/check-links.mjs",
    "figures:dark": "node scripts/dark-figures.mjs",
    "clean": "rm -rf _site",
    "mcp:build": "cd mcp && npm install && npm run build",
    "mcp:run": "cd mcp && npm run start",
    "lint": "f=0; npm run lint:prose || f=1; npm run lint:md || f=1; npm run lint:spell || f=1; exit $f",
    "lint:prose": "vale src/writings",
    "lint:md": "markdownlint-cli2 \"src/writings/**/*.md\"",
    "lint:spell": "cspell lint --no-progress \"src/writings/**/*.md\"",
    "vale:sync": "vale sync",
    "prepare": "husky"
  },
  "keywords": [
    "blog",
    "writings",
    "eleventy",
    "github-pages"
  ],
  "author": "Evan Kim",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "cspell": "^10.3.1",
    "husky": "^9.1.7",
    "katex": "^0.18.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/writings/*.md": [
      "node scripts/lint-frontmatter.mjs",
      "markdownlint-cli2",
      "cspell lint --no-progress --no-summary",
      "vale"
    ]
  },
  "dependencies": {
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "markdown-it-footnote": "^4.0.0"
  }
}
